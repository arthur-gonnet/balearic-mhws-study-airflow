# Copy this file to .env and fill in the values you need. .env is gitignored - never commit
# real credentials.

# User ID Airflow containers run as. On Linux, set this to your own uid (`id -u`) so files
# written into mounted volumes (logs, data) aren't owned by root.
AIRFLOW_UID=1000

# Fernet key used by Airflow to encrypt connection passwords. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# Copernicus Marine Service credentials, used by the download stage of the pipeline.
# Create an account at https://data.marine.copernicus.eu/ if you don't have one.
USERNAME_COPERNICUS=
PASSWORD_COPERNICUS=

# Where raw/processed Zarr stores live. Defaults to <project>/data if left empty.
BALEARIC_DATA_DIR=

# Slurm cluster access, used by the compute_mhws DAG task to submit jobs over SSH instead
# of running the computation in-process. Leave empty to run everything locally in Docker.
SLURM_SSH_HOST=
SLURM_SSH_USER=
SLURM_REMOTE_PROJECT_DIR=
SLURM_PARTITION=
